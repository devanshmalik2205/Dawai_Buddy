<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="40dp">

    <!-- Custom Tabs (Day | Week | Month) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <LinearLayout android:id="@+id/tabDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="32dp" android:clickable="true" android:background="?attr/selectableItemBackground">
            <TextView android:id="@+id/tvTabDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day" android:textColor="?android:attr/textColorSecondary" android:textSize="16sp" />
            <View android:id="@+id/viewTabDayLine" android:layout_width="30dp" android:layout_height="3dp" android:background="#00FF7F" android:layout_marginTop="4dp" android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabWeek" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:background="?attr/selectableItemBackground">
            <TextView android:id="@+id/tvTabWeek" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" />
            <View android:id="@+id/viewTabWeekLine" android:layout_width="30dp" android:layout_height="3dp" android:background="#00FF7F" android:layout_marginTop="4dp" android:visibility="visible" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginStart="32dp" android:clickable="true" android:background="?attr/selectableItemBackground">
            <TextView android:id="@+id/tvTabMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Month" android:textColor="?android:attr/textColorSecondary" android:textSize="16sp" />
            <View android:id="@+id/viewTabMonthLine" android:layout_width="30dp" android:layout_height="3dp" android:background="#00FF7F" android:layout_marginTop="4dp" android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Date Paginator -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="?android:attr/textColorSecondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:gravity="center">
            <TextView
                android:id="@+id/tvDateRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvTotalSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👟 0 steps"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="?android:attr/textColorSecondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================== DAY CHART (Hourly) ================== -->
            <LinearLayout
                android:id="@+id/layoutDayChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <!-- Steps Graph -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Steps" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Y-Axis Predictor (Left Aligned) -->
                    <RelativeLayout
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp">
                        <TextView android:id="@+id/tvDayStepsMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:id="@+id/tvDayStepsMid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:text="0" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:weightSum="4">
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/dayStepsBarsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:baselineAligned="false" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="67dp" android:layout_marginEnd="24dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="12 AM" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="6 AM" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="12 PM" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:text="6 PM (h)" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                </LinearLayout>

                <!-- Calories Graph -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity calories" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" android:layout_marginHorizontal="24dp" android:layout_marginTop="32dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Y-Axis Predictor (Left Aligned) -->
                    <RelativeLayout
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp">
                        <TextView android:id="@+id/tvDayCalMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:id="@+id/tvDayCalMid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:text="0" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:weightSum="4">
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/dayCaloriesBarsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:baselineAligned="false" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="67dp" android:layout_marginEnd="24dp" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="12 AM" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="6 AM" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="12 PM" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:text="6 PM (h)" android:textColor="?android:attr/textColorSecondary" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================== WEEK CHART (Daily) ================== -->
            <LinearLayout
                android:id="@+id/layoutWeekChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:visibility="visible">

                <!-- Steps Graph -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Steps" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Y-Axis Predictor (Left Aligned) -->
                    <RelativeLayout
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp">
                        <TextView android:id="@+id/tvWeekStepsMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:id="@+id/tvWeekStepsMid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:text="0" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:weightSum="4">
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/weekStepsBarsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:baselineAligned="false" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/weekXAxis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="67dp" android:layout_marginEnd="24dp" android:orientation="horizontal"/>

                <!-- Calories Graph -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity calories" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" android:layout_marginHorizontal="24dp" android:layout_marginTop="32dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Y-Axis Predictor (Left Aligned) -->
                    <RelativeLayout
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp">
                        <TextView android:id="@+id/tvWeekCalMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:id="@+id/tvWeekCalMid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="-" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:text="0" android:textSize="10sp" android:textColor="?android:attr/textColorSecondary" android:gravity="end" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:weightSum="4">
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#14888888" />
                            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#05888888" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/weekCaloriesBarsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:baselineAligned="false" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/weekCaloriesXAxis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="67dp" android:layout_marginEnd="24dp" android:orientation="horizontal"/>
            </LinearLayout>

            <!-- ================== MONTH CHART (Minimal Grid) ================== -->
            <LinearLayout
                android:id="@+id/layoutMonthChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <!-- Fixed minimal size grid centered perfectly -->
                <GridLayout
                    android:id="@+id/monthGridContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:columnCount="7"
                    android:layout_marginTop="16dp"
                    android:alignmentMode="alignBounds"
                    android:rowOrderPreserved="false">
                    <!-- Populated programmatically -->
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Mon" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Tue" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Wed" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Thu" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Fri" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sat" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sun" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>